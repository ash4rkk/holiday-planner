{
  "name": "planer",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @planer/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @planer/core db:generate",
    "db:migrate": "pnpm --filter @planer/core db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
