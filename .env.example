# Lokalnie: cp .env.example apps/web/.env.local (Next czyta env tylko z apps/web) i .env (compose).
# Na serwerze /srv/planer/.env zakłada ops/setup-db.sh — resztę uzupełnij ręcznie.

# Lokalny Postgres z profilu `local` (docker compose --profile local up -d postgres).
# Na serwerze: postgresql://planer_app:<hasło>@postgres:5432/planer (wspólny kontener w sieci edge).
DATABASE_URL=postgresql://planer_app:dev@localhost:5433/planer

# Cloudflare Access (Zero Trust → Access → Applications → planer → Overview)
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=
# Druga linia obrony obok polityki Access (przecinki)
ALLOWED_EMAILS=a@example.com,b@example.com
# Imiona: email=Imię;email=Imię (w cudzysłowie — średnik bez niego psuje `source .env` w powłoce)
USER_NAMES="a@example.com=Arek;b@example.com=Ola"

# Adres aplikacji: serwer sync odrzuca WebSocket z innego Origin. Domyślnie https://planer.wiergowsky.com.
# APP_ORIGIN=

# Tylko lokalnie (NODE_ENV=development): pomija JWT. Na serwerze nie ustawiaj.
AUTH_DEV_EMAIL=a@example.com
# Tylko lokalnie: serwer sync na osobnym porcie (pnpm dev:sync). Na serwerze puste — aplikacja
# łączy się z wss://<domena>/sync.
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234

# Web Push (przypomnienia i zmiany drugiej osoby). Klucze raz na zawsze:
#   npx web-push generate-vapid-keys
# Zmiana kluczy unieważnia subskrypcje — trzeba je włączyć ponownie na telefonach.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI (czat i import zdjęć) — klucz z console.anthropic.com; bez niego AI jest wyłączone.
ANTHROPIC_API_KEY=
# Domyślnie claude-opus-5-5. Taniej: claude-sonnet-5-5 (ok. 2× taniej) albo claude-haiku-5-5 (ok. 40× taniej).
ANTHROPIC_MODEL=
# Limit wydatków na AI w miesiącu (zł); po nim czat i import wyłączają się do końca miesiąca.
AI_MONTHLY_BUDGET_PLN=20

# Kopie zapasowe (worker): katalog na hoście (compose), godzina i liczba dni przechowywania.
BACKUP_HOST_DIR=/srv/data/backups/planer
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# PDF z planu: ścieżka do Chromium (w obrazie Dockera ustawiona; lokalnie np. /usr/bin/google-chrome).
CHROMIUM_PATH=
