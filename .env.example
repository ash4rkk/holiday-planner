# Lokalnie: cp .env.example apps/web/.env.local (Next czyta env tylko z apps/web) i .env (compose).
# Na serwerze /srv/planer/.env zakłada ops/setup-db.sh — resztę uzupełnij ręcznie.

# Lokalny Postgres z profilu `local` (docker compose --profile local up -d postgres).
# Na serwerze: postgresql://planer_app:<hasło>@postgres:5432/planer (wspólny kontener w sieci edge).
DATABASE_URL=postgresql://planer_app:dev@localhost:5433/planer

# Cloudflare Access (Zero Trust → Access → Applications → planer → Overview)
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=
# Druga linia obrony obok polityki Access (przecinki)
ALLOWED_EMAILS=a@example.com,b@example.com
# Imiona: email=Imię;email=Imię
USER_NAMES=a@example.com=Arek;b@example.com=Ola

# Tylko lokalnie (NODE_ENV=development): pomija JWT. Na serwerze nie ustawiaj.
AUTH_DEV_EMAIL=a@example.com
